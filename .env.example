# ── Device ───────────────────────────────────────────────────────────────────
DEVICE=cuda              # cuda | cpu | mps
GPU_ID=0
TORCH_DTYPE=float16      # float16 (faster on GPU) | float32 | bfloat16

# ── LLM Provider (choose one) ────────────────────────────────────────────────
# Option A: Anthropic (cloud)
#LLM_PROVIDER=anthropic
#LLM_MODEL=claude-sonnet-4-20250514
#LLM_API_KEY=your_anthropic_api_key_here

# Option B: OpenAI
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o
# LLM_API_KEY=your_openai_api_key_here

# Option C: Ollama (local, fully offline)
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2-vision:11b
LLM_API_KEY=ollama
LLM_BASE_URL=http://localhost:11434/v1

# ── Routing ───────────────────────────────────────────────────────────────────
VALHALLA_URL=http://localhost:8002
USE_OSMNX_FALLBACK=true

# ── Map area ──────────────────────────────────────────────────────────────────
# Change to your local area
OSM_AREA=Dĩ An, Bình Dương, Vietnam
MAP_DEFAULT_LAT=10.9085
MAP_DEFAULT_LON=106.7600

# ── VPR model ─────────────────────────────────────────────────────────────────
VPR_MODEL=dinov2_vitg14          # vitg14 (best) | vitl14 (lighter) | vitb14 (lightest)
VPR_LAYER=31
VPR_FACET=value
VPR_NUM_CLUSTERS=32

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=false
# CORS: use * to allow all origins (phone + laptop on same LAN)
# Or specify: http://192.168.1.100:8000,http://localhost:8000
CORS_ORIGINS=*

# ── Geocoding ─────────────────────────────────────────────────────────────────
# Set to true to allow Nominatim geocoding for unknown place names
ALLOW_REMOTE_GEOCODING=false
